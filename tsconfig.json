{
  "compilerOptions": {
    /* Linguaggio e ambiente */
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    /* Moduli */
    "module": "commonjs",
    "rootDir": "./src",

    /* Emissione */
    "outDir": "./dist",
    "sourceMap": true,

    /* Controlli di tipo rigorosi */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Interoperabilità */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}